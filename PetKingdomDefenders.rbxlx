<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Meta name="ExplicitAutoJoints">true</Meta>
	<External>null</External>
	<External>nil</External>

	<!-- Pet Kingdom Defenders - Roblox Place File -->
	<!-- Import Instructions:
		1. Open Roblox Studio
		2. File → Open from File
		3. Select this .rbxlx file
		4. Studio will load the place structure
		5. Manually copy Lua scripts from /src/map folders to corresponding locations
		6. Or use Rojo/Roblox-TS for automated syncing
	-->

	<!-- WORKSPACE -->
	<Item class="Workspace" referent="RBXWORKSPACE">
		<Properties>
			<string name="Name">Workspace</string>
		</Properties>

		<!-- Spawn Location -->
		<Item class="SpawnLocation" referent="RBX01">
			<Properties>
				<string name="Name">SpawnLocation</string>
				<CoordinateFrame name="CFrame">
					<X>0</X>
					<Y>0.5</Y>
					<Z>0</Z>
					<R00>1</R00>
					<R01>0</R01>
					<R02>0</R02>
					<R10>0</R10>
					<R11>1</R11>
					<R12>0</R12>
					<R20>0</R20>
					<R21>0</R21>
					<R22>1</R22>
				</CoordinateFrame>
				<bool name="Anchored">true</bool>
				<Vector3 name="Size">
					<X>6</X>
					<Y>1</Y>
					<Z>6</Z>
				</Vector3>
			</Properties>
		</Item>

		<!-- Baseplate -->
		<Item class="Part" referent="RBX02">
			<Properties>
				<string name="Name">Baseplate</string>
				<CoordinateFrame name="CFrame">
					<X>0</X>
					<Y>-10</Y>
					<Z>0</Z>
					<R00>1</R00>
					<R01>0</R01>
					<R02>0</R02>
					<R10>0</R10>
					<R11>1</R11>
					<R12>0</R12>
					<R20>0</R20>
					<R21>0</R21>
					<R22>1</R22>
				</CoordinateFrame>
				<bool name="Anchored">true</bool>
				<Vector3 name="Size">
					<X>512</X>
					<Y>20</Y>
					<Z>512</Z>
				</Vector3>
				<BrickColor name="BrickColor">28</BrickColor>
			</Properties>
		</Item>

		<!-- Game Folders -->
		<Item class="Folder" referent="RBX03">
			<Properties>
				<string name="Name">Pets</string>
			</Properties>
		</Item>

		<Item class="Folder" referent="RBX04">
			<Properties>
				<string name="Name">Bases</string>
			</Properties>
		</Item>

		<Item class="Folder" referent="RBX05">
			<Properties>
				<string name="Name">Enemies</string>
			</Properties>
		</Item>

		<Item class="Folder" referent="RBX06">
			<Properties>
				<string name="Name">Obbies</string>
			</Properties>
		</Item>
	</Item>

	<!-- LIGHTING -->
	<Item class="Lighting" referent="RBXLIGHTING">
		<Properties>
			<string name="Name">Lighting</string>
			<Color3 name="Ambient">
				<R>0.5</R>
				<G>0.5</G>
				<B>0.5</B>
			</Color3>
			<Color3 name="OutdoorAmbient">
				<R>0.5</R>
				<G>0.5</G>
				<B>0.5</B>
			</Color3>
			<float name="Brightness">2</float>
		</Properties>
	</Item>

	<!-- REPLICATED STORAGE -->
	<Item class="ReplicatedStorage" referent="RBXREPLICATEDSTORAGE">
		<Properties>
			<string name="Name">ReplicatedStorage</string>
		</Properties>

		<!-- Remotes Folder -->
		<Item class="Folder" referent="RBX10">
			<Properties>
				<string name="Name">Remotes</string>
			</Properties>
			<!-- RemotesSetup.lua creates all 58 RemoteEvents here -->
		</Item>

		<!-- Shared Folder -->
		<Item class="Folder" referent="RBX11">
			<Properties>
				<string name="Name">Shared</string>
			</Properties>
			<!-- Add ModuleScripts: Config.lua, PetData.lua, Utils.lua -->
		</Item>
	</Item>

	<!-- SERVER SCRIPT SERVICE -->
	<Item class="ServerScriptService" referent="RBXSERVERSCRIPTSERVICE">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>

		<!-- Modules Folder -->
		<Item class="Folder" referent="RBX20">
			<Properties>
				<string name="Name">Modules</string>
			</Properties>
			<!-- Add ModuleScripts:
				- SecurityManager.lua
				- DataManager.lua
				- PetSystem.lua
				- TowerDefenseManager.lua
				- TycoonManager.lua
				- EconomyManager.lua
				- TradingSystem.lua
				- ObbyManager.lua
				- EventManager.lua
			-->
		</Item>

		<!-- Server Scripts (add manually in Studio) -->
		<!-- InitializeRemotes.lua -->
		<!-- MainServer.lua -->
	</Item>

	<!-- STARTER PLAYER -->
	<Item class="StarterPlayer" referent="RBXSTARTERPLAYER">
		<Properties>
			<string name="Name">StarterPlayer</string>
		</Properties>

		<Item class="StarterPlayerScripts" referent="RBX30">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>

			<!-- Modules Folder -->
			<Item class="Folder" referent="RBX31">
				<Properties>
					<string name="Name">Modules</string>
				</Properties>
				<!-- Add LocalScripts:
					- UIManager.lua
					- InputManager.lua
					- CameraController.lua
					- SoundManager.lua
					- NotificationManager.lua
				-->
			</Item>

			<!-- MainClient.lua (add manually) -->
		</Item>
	</Item>

	<!-- STARTER GUI -->
	<Item class="StarterGui" referent="RBXSTARTERGUI">
		<Properties>
			<string name="Name">StarterGui</string>
		</Properties>
		<!-- MainUI.lua creates all UI programmatically -->
	</Item>

	<!-- SOUND SERVICE -->
	<Item class="SoundService" referent="RBXSOUNDSERVICE">
		<Properties>
			<string name="Name">SoundService</string>
		</Properties>
		<!-- SoundManager.lua creates sounds here -->
	</Item>

	<!-- PLAYERS -->
	<Item class="Players" referent="RBXPLAYERS">
		<Properties>
			<string name="Name">Players</string>
		</Properties>
	</Item>

	<!-- TEAMS (Optional) -->
	<Item class="Teams" referent="RBXTEAMS">
		<Properties>
			<string name="Name">Teams</string>
		</Properties>
	</Item>

</roblox>
