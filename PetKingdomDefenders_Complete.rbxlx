					<R10>0</R10>
					<R11>1</R11>
					<R12>0</R12>
					<R20>0</R20>
					<R21>0</R21>
					<R22>1</R22>
				</CoordinateFrame>
				<bool name="Anchored">true</bool>
				<Vector3 name="Size">
					<X>512</X>
					<Y>20</Y>
					<Z>512</Z>
				</Vector3>
				<BrickColor name="BrickColor">28</BrickColor>
			</Properties>
		</Item>

		<!-- Game Folders -->
		<Item class="Folder" referent="RBX03">
			<Properties>
				<string name="Name">Pets</string>
			</Properties>
		</Item>

		<Item class="Folder" referent="RBX04">
